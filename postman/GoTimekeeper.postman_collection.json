{
  "info": {
    "_postman_id": "7de9e882-a378-4d34-8d6d-51fd37c943ca",
    "name": "GoTimekeeper Flow",
    "description": "Registers a user, creates 3 projects and 3 tasks, starts and stops each task with a configurable wait, then fetches general, project, and task reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const getValue = (key) => pm.variables.get(key);",
          "const setEnv = (key, value) => postman.setEnvironmentVariable(key, value);",
          "const setDefault = (key, value) => {",
          "  if (!getValue(key)) {",
          "    setEnv(key, value);",
          "  }",
          "};",
          "const suffix = getValue('runSuffix') || String(Date.now());",
          "if (!pm.environment.get('runSuffix')) setEnv('runSuffix', suffix);",
          "",
          "setDefault('baseUrl', 'http://localhost:8080');",
          "setDefault('timezone', 'Europe/Prague');",
          "setDefault('waitMs', '65000');",
          "setDefault('userPassword', 'User1@password');",
          "setDefault('userEmail', `postman_${suffix}@example.com`);",
          "",
          "setDefault('project1Name', `Project 1 ${suffix}`);",
          "setDefault('project2Name', `Project 2 ${suffix}`);",
          "setDefault('project3Name', `Project 3 ${suffix}`);",
          "setDefault('task1Name', `Task 1 ${suffix}`);",
          "setDefault('task2Name', `Task 2 ${suffix}`);",
          "setDefault('task3Name', `Task 3 ${suffix}`);",
          "",
          "if (!getValue('reportFromDate')) {",
          "  const now = new Date();",
          "  const from = new Date(now);",
          "  from.setDate(now.getDate() - 1);",
          "  from.setHours(0, 0, 0, 0);",
          "  const value = from.toISOString();",
          "  setEnv('reportFromDate', value);",
          "}",
          "",
          "if (!getValue('reportToDate')) {",
          "  const to = new Date();",
          "  to.setDate(to.getDate() + 1);",
          "  to.setHours(23, 59, 59, 999);",
          "  const value = to.toISOString();",
          "  setEnv('reportToDate', value);",
          "}"
        ]
      }
    }
  ],
